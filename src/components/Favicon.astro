---
import type { FaviconConfig } from "@/types/config";
import { getPublicAssetPath } from "@/utils/publicAssets";

interface Props {
  favicon: FaviconConfig;
}

const { favicon } = Astro.props;
---

{/* SVG 图标 */}
{
  favicon.svg && (
    <link rel="icon" type="image/svg+xml" href={getPublicAssetPath(favicon.svg)} />
  )
}

{/* PNG 图标 */}
{
  favicon.png && (
    <link rel="icon" type="image/png" href={getPublicAssetPath(favicon.png)} />
  )
}

{/* 传统 ICO 格式，兼容旧浏览器与 Windows 桌面快捷方式 */}
{
  favicon.ico && (
    <link rel="icon" type="image/x-icon" href={getPublicAssetPath(favicon.ico)} />
  )
}

{/* Apple Touch Icon，iOS 主屏图标，推荐 180x180 PNG */}
{
  favicon.appleTouchIcon && (
    <link rel="apple-touch-icon" href={getPublicAssetPath(favicon.appleTouchIcon)} />
  )
}

{/* Web App Manifest，Android 主屏/PWA 元数据 */}
{
  favicon.manifest && (
    <link rel="manifest" href={getPublicAssetPath(favicon.manifest)} />
  )
}
